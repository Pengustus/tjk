<!DOCTYPE html>
<html lang="bg" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TJK Delta</title>
    <meta name="description" content="TJK Delta - Индустриални машини за арматура и префaбрикати." />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Theme (Dark Mode, Strict Black & White Industrial, No rounded corners, No borders) -->
    <link rel="stylesheet" href="~/css/tjk-theme.css" asp-append-version="true" />
</head>
<body>
    <!-- Main Header (Dark Mode, large original white-text logo) -->
    <header class="tjk-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark tjk-navbar py-3">
            <div class="container-fluid px-lg-5">
                <a class="navbar-brand py-0 me-4" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-white.png" alt="TJK Delta" class="tjk-logo-img" />
                </a>

                <button class="navbar-toggler border-0 shadow-none rounded-0" type="button" data-bs-toggle="collapse" data-bs-target="#tjkNavbarCollapse" aria-controls="tjkNavbarCollapse" aria-expanded="false" aria-label="Превключване на менюто">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="tjkNavbarCollapse">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-3">
                        <li class="nav-item">
                            <a class="nav-link tjk-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                НАЧАЛО
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tjk-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "active" : "")" asp-controller="Home" asp-action="Products">
                                МАШИНИ & КАТАЛОГ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tjk-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Services" ? "active" : "")" asp-controller="Home" asp-action="Services">
                                УСЛУГИ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tjk-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">
                                ЗА TJK DELTA
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tjk-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Home" asp-action="Contact">
                                КОНТАКТИ
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Admin" asp-action="Inquiries" class="btn btn-sm btn-outline-light rounded-0 text-uppercase fw-bold" style="font-size: 0.75rem;">
                                <i class="bi bi-shield-check me-1"></i>Админ CRM
                            </a>
                            <a asp-controller="Admin" asp-action="Logout" class="btn btn-sm btn-outline-danger rounded-0" style="font-size: 0.75rem;" title="Изход">
                                <i class="bi bi-box-arrow-right"></i>
                            </a>
                        }
                        <a asp-controller="Home" asp-action="Contact" class="btn-tjk-primary">
                            ЗАПИТВАНЕ
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer (Dark, Square, Original Logo) -->
    <footer class="tjk-footer">
        <div class="container-fluid px-lg-5">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <a asp-controller="Home" asp-action="Index" class="d-inline-block mb-3">
                        <img src="~/images/logo-white.png" alt="TJK Delta" class="tjk-footer-logo-img" />
                    </a>
                    <p class="tjk-footer-desc pe-lg-4 small mb-0">
                        Индустриални машини за арматурни дворове и заводи за префaбрициран бетон. Автоматизирани системи за огъване, рязане и заваряване.
                    </p>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="text-uppercase text-white mb-3">Каталог Машини</h5>
                    <ul class="tjk-footer-links">
                        <li><a asp-controller="Home" asp-action="Products" asp-route-category="estribadoras">Стремежови автомати</a></li>
                        <li><a asp-controller="Home" asp-action="Products" asp-route-category="ryazane-razmer">Линии за рязане</a></li>
                        <li><a asp-controller="Home" asp-action="Products" asp-route-category="ryazane-ogyvane">Рязане и огъване</a></li>
                        <li><a asp-controller="Home" asp-action="Products" asp-route-category="izpravyane">Изправяне и рязане</a></li>
                        <li><a asp-controller="Home" asp-action="Products" asp-route-category="armaturni-kosheve">Арматурни кошове</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="text-uppercase text-white mb-3">Навигация</h5>
                    <ul class="tjk-footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Начало</a></li>
                        <li><a asp-controller="Home" asp-action="Products">Машини</a></li>
                        <li><a asp-controller="Home" asp-action="Services">Услуги</a></li>
                        <li><a asp-controller="Home" asp-action="About">За TJK Delta</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Контакти</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="text-uppercase text-white mb-3">Контакти</h5>
                    <div class="d-flex flex-column gap-2 small tjk-footer-contact">
                        <div><i class="bi bi-geo-alt-fill me-2 text-white"></i>ул. Виница 19, София 1111</div>
                        <div><i class="bi bi-telephone-fill me-2 text-white"></i><a href="tel:(02) 964 12 25" class="text-white text-decoration-none">+359 2 900 1234</a></div>
                        <div><i class="bi bi-phone-fill me-2 text-white"></i><a href="tel:(02) 964 12 26" class="text-white text-decoration-none">+359 888 123 456</a></div>
                        <div><i class="bi bi-envelope-fill me-2 text-white"></i><a href="mailto:office@tjkdelta.com" class="text-white text-decoration-none">office@tjkdelta.com</a></div>
                        <div><i class="bi bi-clock-fill me-2 text-white"></i>Пн - Пт: 08:30 - 17:30 ч.</div>
                    </div>
                </div>
            </div>

            <div class="tjk-footer-bottom d-flex flex-wrap justify-content-between align-items-center pt-3 mt-4">
                <div class="small tjk-copyright">
                    &copy; @DateTime.Now.Year TJK DELTA BULGARIA. ВСИЧКИ ПРАВА ЗАПАЗЕНИ.
                </div>
                <div class="d-flex gap-4 small mt-2 mt-md-0 align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Admin" asp-action="Inquiries" class="tjk-legal-link"><i class="bi bi-shield-check me-1"></i>Админ (@User.Identity.Name)</a>
                        <a asp-controller="Admin" asp-action="Logout" class="tjk-legal-link text-danger"><i class="bi bi-box-arrow-right me-1"></i>Изход</a>
                    }
                    else
                    {
                        <a asp-controller="Admin" asp-action="Login" class="tjk-legal-link"><i class="bi bi-shield-lock me-1"></i>Вход Администратор</a>
                    }
                    <a asp-controller="Home" asp-action="Privacy" class="tjk-legal-link">Политика за поверителност</a>
                    <a asp-controller="Home" asp-action="Contact" class="tjk-legal-link">Контакти</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
