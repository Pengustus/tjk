@{
    ViewData["Title"] = "За TJK Delta";
}

<div class="tjk-page-header">
    <div class="container-fluid px-lg-5">
        <div class="small text-uppercase fw-bold text-muted mb-2">ПРЕДСТАВИТЕЛСТВО</div>
        <h1 class="display-6 fw-bold text-uppercase mb-0">ЗА TJK DELTA</h1>
    </div>
</div>

<div class="tjk-section">
    <div class="container-fluid px-lg-5">
        <div class="row align-items-center g-5 mb-5">
            <div class="col-lg-6">
                <div class="tjk-eyebrow">TJK MACHINERY</div>
                <h2 class="h2 fw-bold text-uppercase text-white mb-4">ТЕХНОЛОГИИ ЗА АРМАТУРНАТА ИНДУСТРИЯ</h2>
                <p class="mb-3 lead fs-6">
                    TJK е водещ световен производител на автоматизирано оборудване за обработка на арматурно желязо, включително стремежови автомати, линии за рязане, заваръчни машини за арматурни кошове и мрежи.
                </p>
                <p class="mb-4">
                    TJK Delta осигурява директен достъп до технологиите на TJK, консултации при избора на машини, доставка, монтаж и пълна сервизна поддръжка за българския пазар.
                </p>
                <div>
                    <a asp-controller="Home" asp-action="Products" class="btn-tjk-primary me-3">
                        КАТАЛОГ МАШИНИ
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="btn-tjk-outline">
                        СВЪРЖЕТЕ СЕ С НАС
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <img src="https://tjkserecon.s3.eu-central-1.amazonaws.com/wp-content/uploads/2025/07/26153746/WG16-F2-7.jpg" alt="TJK Machinery" class="w-100 shadow" style="aspect-ratio: 16/11; object-fit: cover;" />
            </div>
        </div>

        <div class="row g-4 pt-4 border-top border-secondary border-opacity-25">
            <div class="col-md-4">
                <div class="p-4 h-100" style="background-color: var(--tjk-surface);">
                    <h4 class="h6 fw-bold text-uppercase text-white mb-2">ПРЕЦИЗНОСТ</h4>
                    <p class="small mb-0">
                        Сервоуправлявани системи за висока точност на огъване и рязане при минимален технологичен брак.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 h-100" style="background-color: var(--tjk-surface);">
                    <h4 class="h6 fw-bold text-uppercase text-white mb-2">ПРОИЗВОДИТЕЛНОСТ</h4>
                    <p class="small mb-0">
                        Високоскоростно подаване и изправяне на тел за интензивни производствени графици.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 h-100" style="background-color: var(--tjk-surface);">
                    <h4 class="h6 fw-bold text-uppercase text-white mb-2">ПОДДРЪЖКА</h4>
                    <p class="small mb-0">
                        Оригинални консумативи, резервни части и техническа помощ за безпроблемна работа.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
